@startuml
title CJM — Пользователь

start

:Открывает приложение;

:Запрашивает список ресторанов;
:GET /api/v1/restaurants;

if (Есть доступные рестораны?) then (Да)
    :Выбирает ресторан;

    :Запрашивает меню;
    :GET /api/v1/restaurants/{id}/menu;

    :Выбирает блюда;
    :Формирует корзину;

    :Указывает адрес доставки;

    :Создаёт заказ;
    :POST /api/v1/orders;

    if (Заказ создан?) then (Да)
        :Заказ получает статус pending;

        :Система отправляет заказ\nв сервис ресторана;

        if (Ресторан принял заказ?) then (Да)
            :Статус → accepted;

            :Ресторан готовит заказ;
            :Статус → preparing;

            :Заказ готов;
            :Статус → ready;

            :Заказ передан в доставку;
            :Статус → delivering;

            :Заказ доставлен;
            :Статус → delivered;

            :Пользователь получает заказ;
        else (Нет)
            :Статус → rejected;
            :Пользователь получает уведомление\nоб отклонении заказа;
        endif

    else (Нет)
        :Получает ошибку создания заказа;
    endif

else (Нет)
    :Получает пустой список;
endif

stop

@enduml